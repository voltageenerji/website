# Cloudflare Pages — HTTP başlıkları
# Docs: https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https:; connect-src 'self' https://epias-proxy.emirhantan-ku.workers.dev; frame-ancestors 'self';

# HTML — kısa cache, revalidate
/*.html
  Cache-Control: public, max-age=300, must-revalidate

# Kök sayfa — "/*.html" kuralı "/" ile EŞLEŞMEZ, aynı kural ayrıca tanımlanır
/
  Cache-Control: public, max-age=300, must-revalidate

# Temiz URL'ler — "/*.html" kuralı uzantısız istek yollarıyla EŞLEŞMEZ (O2)
/kvkk
  Cache-Control: public, max-age=300, must-revalidate

/cerez-politikasi
  Cache-Control: public, max-age=300, must-revalidate

/kullanim-kosullari
  Cache-Control: public, max-age=300, must-revalidate

# API (Pages Functions) — asla cache'leme, asla indeksleme (O1)
/api/*
  Cache-Control: no-store
  X-Robots-Tag: noindex

# Statik asset'ler (ileride kullanırsan) — uzun cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable
