# Cloudflare Pages — HTTP başlıkları
# Docs: https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://epias-proxy.emirhantan-ku.workers.dev https://static.cloudflareinsights.com https://cloudflareinsights.com; frame-ancestors 'self';

# Önizleme adresleri arama dizinine girmesin (Cloudflare Pages belgesindeki kalıp:
# https://developers.cloudflare.com/pages/configuration/headers/).
# YALNIZ *.pages.dev adresleri (projenin pages.dev adresi, dal ve sürüm önizlemeleri) bu
# kurallarla eşleşir; üretim alan adı voltage.com.tr ETKİLENMEZ.
# _headers Pages Function yanıtlarına UYGULANMAZ: Function'lı /canli-ptf, /dengesizlik-maliyeti ve
# /dengesizlik-maliyeti/veri aynı başlığı kendileri ekler (functions/_lib/onizleme.js).
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex

# HTML — kısa cache, revalidate
/*.html
  Cache-Control: public, max-age=300, must-revalidate

# Kök sayfa — "/*.html" kuralı "/" ile EŞLEŞMEZ, aynı kural ayrıca tanımlanır
/
  Cache-Control: public, max-age=300, must-revalidate

# Temiz URL'ler — "/*.html" kuralı uzantısız istek yollarıyla EŞLEŞMEZ (O2)
/kvkk
  Cache-Control: public, max-age=300, must-revalidate

/cerez-politikasi
  Cache-Control: public, max-age=300, must-revalidate

/kullanim-kosullari
  Cache-Control: public, max-age=300, must-revalidate

# Canlı PTF veri sayfası: SUNUCU TARAFINDA render edilir (functions/canli-ptf.js).
# Cache-Control'ü BİLEREK burada tanımlamıyoruz — fonksiyon kendi penceresini
# seçer (veri varsa 60/300 sn, dürüst bekleme hâlinde 30/60 sn). Buraya kural
# yazmak o ayrımı ezer ve bir kesintiyi CDN'de 5 dakika dondururdu (QA DEF-5).

# Dengesizlik Maliyeti (/dengesizlik-maliyeti ve /dengesizlik-maliyeti/veri): ikisi de
# Pages Function'dır (functions/dengesizlik-maliyeti.js, functions/dengesizlik-maliyeti/veri.js)
# ve Cache-Control'ü kendileri seçer (veri varsa / bekleme hâli / bayat veri ayrı pencereler).
# Canlı PTF ile aynı gerekçeyle buraya BİLEREK kural yazılmadı (QA DEF-5). Sayfa yanıtı
# kabuğun güvenlik başlıklarını (yukarıdaki "/*" kuralı) korur.

/kurumsal
  Cache-Control: public, max-age=300, must-revalidate

/sanayi-elektrik-tedariki
  Cache-Control: public, max-age=300, must-revalidate

/elektrik-faturasi-hesaplama
  Cache-Control: public, max-age=300, must-revalidate

# Rehber bölümü (hub + makaleler, uzantısız temiz URL'ler)
/rehber
  Cache-Control: public, max-age=300, must-revalidate

/rehber/*
  Cache-Control: public, max-age=300, must-revalidate

# Sayfa başına paylaşım kartları (og:image / twitter:image)
# Dosya adları sayfa slug'ından türer, içerik hash'i TAŞIMAZ: bir sayfanın başlığı
# değişip kart yeniden üretildiğinde aynı ad yeni içerikle döner. Bu yüzden "immutable"
# GÜVENLİ DEĞİLDİR (revalidate edilmeyen eski kart 1 yıl boyunca servis edilirdi).
# 1 gün + revalidate: kartlar sayfa tarafından yüklenmez, yalnız paylaşım robotları
# çeker; performans etkisi yoktur, tazelik kazanılır.
/og/*
  Cache-Control: public, max-age=86400, must-revalidate

# Ana sayfa görselleri (kapak ve sektör fotoğrafları, WebP). Sayfa yükler (masaüstünde kapak LCP öğesidir).
# Dosya adları içerik hash'i TAŞIMAZ ve görseller aynı adla değiştirilebilir: "immutable"
# GÜVENLİ DEĞİLDİR. 1 gün + revalidate: tekrar ziyarette istek 304 ile döner.
/img/*
  Cache-Control: public, max-age=86400, must-revalidate

# Feed (Pages Functions) — köprüler (Zapier/Buffer) okur; kısa cache.
# noindex yalnızca arama sonuçlarını temiz tutar, fetch tabanlı köprüleri ETKİLEMEZ.
/feed/*
  Cache-Control: public, max-age=300
  X-Robots-Tag: noindex

# Yönetim paneli — kişisel veri gösterir: asla cache'lenmez, asla indekslenmez,
# çerçevelenemez ve referrer sızdırmaz.
# CSP Level 2: frame-ancestors varsa tarayıcı X-Frame-Options'ı YOK SAYAR.
# Kök kural "/*" frame-ancestors 'self' veriyor; panel için 'none' ile ezilir
# (QA N5). Panelin kendi CSP'si aşağıda tam olarak yeniden tanımlanır.
# Yorum blok DIŞINDA: içeride kalırsa ayrıştırıcı CSP satırını düşürebilir (QA N12).
/panel
  Cache-Control: no-store, private
  X-Robots-Tag: noindex, nofollow, noarchive
  Referrer-Policy: no-referrer
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'

/api/admin/*
  Cache-Control: no-store, private
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer

# API (Pages Functions) — asla cache'leme, asla indeksleme (O1)
/api/*
  Cache-Control: no-store
  X-Robots-Tag: noindex

# 404 oyun paketi — dosya adı hash'siz (dağıtımda üzerine yazılır), bu yüzden
# "immutable" GÜVENLİ DEĞİL: 1 saat + revalidate.
/g404/*
  Cache-Control: public, max-age=3600, must-revalidate
