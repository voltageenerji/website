# Cloudflare Pages — HTTP başlıkları
# Docs: https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://epias-proxy.emirhantan-ku.workers.dev https://static.cloudflareinsights.com; frame-ancestors 'self';

# HTML — kısa cache, revalidate
/*.html
  Cache-Control: public, max-age=300, must-revalidate

# Kök sayfa — "/*.html" kuralı "/" ile EŞLEŞMEZ, aynı kural ayrıca tanımlanır
/
  Cache-Control: public, max-age=300, must-revalidate

# Temiz URL'ler — "/*.html" kuralı uzantısız istek yollarıyla EŞLEŞMEZ (O2)
/kvkk
  Cache-Control: public, max-age=300, must-revalidate

/cerez-politikasi
  Cache-Control: public, max-age=300, must-revalidate

/kullanim-kosullari
  Cache-Control: public, max-age=300, must-revalidate

# Canlı PTF veri sayfası: SUNUCU TARAFINDA render edilir (functions/canli-ptf.js).
# Cache-Control'ü BİLEREK burada tanımlamıyoruz — fonksiyon kendi penceresini
# seçer (veri varsa 60/300 sn, dürüst bekleme hâlinde 30/60 sn). Buraya kural
# yazmak o ayrımı ezer ve bir kesintiyi CDN'de 5 dakika dondururdu (QA DEF-5).

/kurumsal
  Cache-Control: public, max-age=300, must-revalidate

# Rehber bölümü (hub + makaleler, uzantısız temiz URL'ler)
/rehber
  Cache-Control: public, max-age=300, must-revalidate

/rehber/*
  Cache-Control: public, max-age=300, must-revalidate

# Sayfa başına paylaşım kartları (og:image / twitter:image)
# Dosya adları sayfa slug'ından türer, içerik hash'i TAŞIMAZ: bir sayfanın başlığı
# değişip kart yeniden üretildiğinde aynı ad yeni içerikle döner. Bu yüzden "immutable"
# GÜVENLİ DEĞİLDİR (revalidate edilmeyen eski kart 1 yıl boyunca servis edilirdi).
# 1 gün + revalidate: kartlar sayfa tarafından yüklenmez, yalnız paylaşım robotları
# çeker; performans etkisi yoktur, tazelik kazanılır.
/og/*
  Cache-Control: public, max-age=86400, must-revalidate

# Feed (Pages Functions) — köprüler (Zapier/Buffer) okur; kısa cache.
# noindex yalnızca arama sonuçlarını temiz tutar, fetch tabanlı köprüleri ETKİLEMEZ.
/feed/*
  Cache-Control: public, max-age=300
  X-Robots-Tag: noindex

# API (Pages Functions) — asla cache'leme, asla indeksleme (O1)
/api/*
  Cache-Control: no-store
  X-Robots-Tag: noindex

# 404 oyun paketi — dosya adı hash'siz (dağıtımda üzerine yazılır), bu yüzden
# "immutable" GÜVENLİ DEĞİL: 1 saat + revalidate.
/g404/*
  Cache-Control: public, max-age=3600, must-revalidate
